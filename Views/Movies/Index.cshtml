@model IEnumerable<Movie>

@{
    ViewData["Title"] = "Movies";
}

<h1>List Of Movies</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table" bgcolor="black">
    <thead>
        <tr bgcolor="gray">
            <th>
                @Html.DisplayNameFor(model => model.Title)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Genre)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ReleaseYear)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.RentalPrice)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr bgcolor="lightgray">
            <td>
                @Html.DisplayFor(modelItem => item.Title)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Genre)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.ReleaseYear)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.RentalPrice)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.MovieId" class="btn btn-outline-primary">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.MovieId" class="btn btn-outline-info">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.MovieId" class="btn btn-outline-warning">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
