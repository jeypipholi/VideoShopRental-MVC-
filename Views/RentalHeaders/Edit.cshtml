@model VideoShopRentalV3.Models.RentalHeader

@{
    ViewData["Title"] = "Edit";
}

<h1>Edit</h1>

<h4>RentalHeader</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="RentalHeaderId" />
            <div class="form-group">
                <label asp-for="CustomerId" class="control-label"></label>
                <select asp-for="CustomerId" class="form-control" asp-items="ViewBag.CustomerId"></select>
                <span asp-validation-for="CustomerId" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="RentalDate" class="control-label"></label>
                <input asp-for="RentalDate" class="form-control" />
                <span asp-validation-for="RentalDate" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="ReturnDate" class="control-label"></label>
                <input asp-for="ReturnDate" class="form-control" />
                <span asp-validation-for="ReturnDate" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Movies" class="control-label"></label>
                <input asp-for="Movies" class="form-control" />
                <span asp-validation-for="Movies" class="text-danger"></span>
                <div>
                    @if (ViewBag.RentalDetails != null && ViewBag.Movies != null)
                    {
                        var movies = ViewBag.Movies as List<Movie>; // Explicitly cast ViewBag.Movies

                        <ul>
                            @foreach (var rental in ViewBag.RentalDetails)
                            {
                                var movie = movies?.FirstOrDefault(m => m.MovieId == rental.MovieId);
                                if (movie != null)
                                {
                                    <li>@movie.MovieId - @movie.Title</li>
                                }
                            }
                        </ul>
                    }
                    else
                    {
                        <p class="text-muted">No movies found for this rental.</p>
                    }
                </div>
            </div>
            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
