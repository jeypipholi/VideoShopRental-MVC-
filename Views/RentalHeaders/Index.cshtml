@model IEnumerable<VideoShopRentalV3.Models.RentalHeader>

@{
    ViewData["Title"] = "Rental";
}

<h1>Rental</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead >
        <tr bgcolor="#2C3E50">
            <th style="color:white">
                @Html.DisplayNameFor(model => model.RentalDate) 
            </th>
            <th style="color:white">
                @Html.DisplayNameFor(model => model.ReturnDate)
            </th>
            <th style="color:white">
                @Html.DisplayNameFor(model => model.MovieIds)
            </th>
            <th style="color:white">
                @Html.DisplayNameFor(model => model.Customer)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
            <tr bgcolor="#D5DBDB">
            <td>
                @Html.DisplayFor(modelItem => item.RentalDate)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.ReturnDate)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.MovieIds)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Customer.FirstName)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.RentalHeaderId" class="btn btn-outline-primary">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.RentalHeaderId" class="btn btn-outline-info">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.RentalHeaderId" class="btn btn-outline-warning">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
